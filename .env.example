# ====================================================================
# UNAVULINK CONFIGURATION ENVIRONMENT VARIABLES
# ====================================================================

# 1. Supabase Backend Integration (Optional for local autonomous demo)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2. Google Gemini Vision & AI API Integration
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. OpenStreetMap / Leaflet Configuration
VITE_DEFAULT_CITY=Coimbatore
VITE_DEFAULT_LAT=11.0168
VITE_DEFAULT_LNG=76.9558

# 4. Environment
VITE_APP_ENV=production
